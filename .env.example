# Telegram
TOKEN=123456789:AAExampleTelegramBotToken

# GigaChat (Authorization key из личного кабинета developers.sber.ru)
GIGACHAT_CREDENTIALS=your_gigachat_authorization_key
GIGACHAT_VERIFY_SSL_CERTS=false
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Kandinsky / FusionBrain
KANDINSKY_API_KEY=your_kandinsky_api_key
KANDINSKY_SECRET_KEY=your_kandinsky_secret_key
KANDINSKY_URL=https://api-key.fusionbrain.ai/

# Путь к базе SQLite (необязательно)
# DB_PATH=nko_bot.db
